[gd_resource type="Resource" script_class="PerkBranchDef" format=3]

; Every rung of the ladder carries an Attunement beside it, so the Level Points
; keep arriving as the colony reaches further.
;
; The two children alternate sides down the chain - Attunement first on an
; even depth, second on an odd one. That is a layout constraint, not a
; preference: PerkTree spaces siblings by the branch's widest accumulated
; offset, and hanging every Attunement on the same side turns the chain into a
; staircase whose offset grows by half a step per rung. At seven rungs that
; crushed Reach's sibling spread from 26 degrees to under 7 and put every
; Attunement label on top of the Reach node beside it. Alternating keeps the
; chain within one step of its centre line, and the spread at 20 degrees.

[ext_resource type="Script" uid="uid://bidkvks0jdm2w" path="res://model/prestige/gd_perk_branch_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="1_uer3u"]
