[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_relics_def.tres" id="3_cur_relics"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="4_effect_script"]

[sub_resource type="Resource" id="payout_relics"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_relics")
gain_stat = &"relic_gain"
_amount_mantissa = 1.8
_amount_exponent = 1

[sub_resource type="Resource" id="reward_0"]
script = ExtResource("4_effect_script")
stat = &"tick_rate"
op = 0
scope = 0
target = &""
per_level = -0.5
level_scaling = 0
max_magnitude = 4.0

[resource]
script = ExtResource("1_script")
id = &"pry_the_flagstones"
display_name = "Pry the Flagstones"
description = "Whatever the builders buried, they buried it under the floor. Lift the floor."
is_farm = false
base_duration_seconds = 120.0
min_creature_rank = 1
min_missions_completed = 3
unlock_perk_id = &""
requires_mission_id = &""
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_relics")])
rewards = Array[ExtResource("4_effect_script")]([SubResource("reward_0")])
