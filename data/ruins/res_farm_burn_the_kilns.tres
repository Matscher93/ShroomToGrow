[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_relics_def.tres" id="3_cur_relics"]
[ext_resource type="Resource" path="res://data/currencies/res_ichor_def.tres" id="4_cur_ichor"]

[sub_resource type="Resource" id="payout_relics"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_relics")
gain_stat = &"relic_gain"
_amount_mantissa = 5.4
_amount_exponent = 2

[sub_resource type="Resource" id="payout_ichor"]
script = ExtResource("2_payout_script")
currency = ExtResource("4_cur_ichor")
gain_stat = &"ichor_gain"
_amount_mantissa = 3.6
_amount_exponent = 2

[resource]
script = ExtResource("1_script")
id = &"farm_burn_the_kilns"
display_name = "Burn The Kilns"
description = "A standing detail, worked by whoever can be spared. Opened by Bone Hauler."
is_farm = true
hero_id = &""
base_duration_seconds = 1200.0
min_hero_level = 1
min_missions_completed = 0
unlock_perk_id = &""
requires_mission_id = &"bone_hauler_lever_the_bone_kilns"
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_relics"), SubResource("payout_ichor")])
