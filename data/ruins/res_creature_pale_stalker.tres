[resource]
script = ExtResource("1_script")
id = &"pale_stalker"
display_name = "Pale Stalker"
description = "Long in the leg and quiet on stone. It hunted these galleries before the doors were shut."
affinity = Array[StringName]([&"stalk_the_galleries", &"bleed_the_swarm", &"hollow_the_brood", &"drain_the_warden"])
speed_per_rank = 0.18
yield_per_rank = 0.16
affinity_bonus = 0.5
base_rank_cap = 6
min_missions_completed = 4
recruit_currency = ExtResource("2_cur_relics")
_recruit_cost_mantissa = 1.2
_recruit_cost_exponent = 2
rank_currency = ExtResource("3_cur_ichor")
_rank_base_cost_mantissa = 2.0
_rank_base_cost_exponent = 1
rank_cost_growth = 1.7
