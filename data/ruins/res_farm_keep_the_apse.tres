[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_relics_def.tres" id="3_cur_relics"]
[ext_resource type="Resource" path="res://data/currencies/res_glyphs_def.tres" id="4_cur_glyphs"]

[sub_resource type="Resource" id="payout_relics"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_relics")
gain_stat = &"relic_gain"
_amount_mantissa = 3.6
_amount_exponent = 3

[sub_resource type="Resource" id="payout_glyphs"]
script = ExtResource("2_payout_script")
currency = ExtResource("4_cur_glyphs")
gain_stat = &"glyph_gain"
_amount_mantissa = 2.4
_amount_exponent = 3

[resource]
script = ExtResource("1_script")
id = &"farm_keep_the_apse"
display_name = "Keep The Apse"
description = "A standing detail, worked by whoever can be spared. Opened by Sanctum Herald."
is_farm = true
hero_id = &""
base_duration_seconds = 2400.0
min_hero_level = 1
min_missions_completed = 0
unlock_perk_id = &""
requires_mission_id = &"sanctum_herald_ordain_the_bright_vault"
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_relics"), SubResource("payout_glyphs")])
