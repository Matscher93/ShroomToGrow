_amount_mantissa = 2.175317
_amount_exponent = 5

[sub_resource type="Resource" id="payout_glyphs"]
script = ExtResource("2_payout_script")
currency = ExtResource("5_cur_glyphs")
gain_stat = &"glyph_gain"
_amount_mantissa = 1.450211
_amount_exponent = 5

[resource]
script = ExtResource("1_script")
id = &"sealed_choir_become_the_undermind"
display_name = "Become the Undermind"
description = "Become the Undermind. Step 16 of The Sealed Choir's chain."
is_farm = false
