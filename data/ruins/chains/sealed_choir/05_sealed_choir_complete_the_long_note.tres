[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_relics_def.tres" id="3_cur_relics"]
[ext_resource type="Resource" path="res://data/currencies/res_ichor_def.tres" id="4_cur_ichor"]
[ext_resource type="Resource" path="res://data/currencies/res_glyphs_def.tres" id="5_cur_glyphs"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="6_effect_script"]

[sub_resource type="Resource" id="payout_relics"]
script = ExtResource("2_payout_script")
