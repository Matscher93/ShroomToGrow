gain_stat = &"relic_gain"
_amount_mantissa = 3.309862
_amount_exponent = 3

[sub_resource type="Resource" id="payout_ichor"]
script = ExtResource("2_payout_script")
currency = ExtResource("4_cur_ichor")
gain_stat = &"ichor_gain"
_amount_mantissa = 1.985917
_amount_exponent = 3

[sub_resource type="Resource" id="payout_glyphs"]
script = ExtResource("2_payout_script")
currency = ExtResource("5_cur_glyphs")
gain_stat = &"glyph_gain"
_amount_mantissa = 1.323945
_amount_exponent = 3

[sub_resource type="Resource" id="reward_0"]
script = ExtResource("6_effect_script")
stat = &"farm_slots"
op = 0
scope = 0
target = &""
per_level = 1.0
level_scaling = 0

[resource]
script = ExtResource("1_script")
id = &"sealed_choir_complete_the_long_note"
display_name = "Complete the Long Note"
description = "Complete the Long Note. Step 5 of The Sealed Choir's chain."
is_farm = false
hero_id = &"sealed_choir"
base_duration_seconds = 3226.8
min_hero_level = 1
min_missions_completed = 0
unlock_perk_id = &""
requires_mission_id = &""
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_relics"), SubResource("payout_ichor"), SubResource("payout_glyphs")])
rewards = Array[ExtResource("6_effect_script")]([SubResource("reward_0")])
