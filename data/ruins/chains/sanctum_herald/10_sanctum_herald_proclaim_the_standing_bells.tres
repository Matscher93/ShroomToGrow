_amount_mantissa = 6.194352
_amount_exponent = 3

[sub_resource type="Resource" id="reward_0"]
script = ExtResource("5_effect_script")
stat = &"tick_rate"
op = 0
scope = 0
target = &""
per_level = -0.75
level_scaling = 0
max_magnitude = 4.0

[resource]
script = ExtResource("1_script")
id = &"sanctum_herald_proclaim_the_standing_bells"
display_name = "Proclaim the Standing Bells"
description = "Proclaim the Standing Bells. Step 10 of Sanctum Herald's chain."
is_farm = false
hero_id = &"sanctum_herald"
base_duration_seconds = 3719.8
min_hero_level = 1
min_missions_completed = 0
unlock_perk_id = &""
requires_mission_id = &""
