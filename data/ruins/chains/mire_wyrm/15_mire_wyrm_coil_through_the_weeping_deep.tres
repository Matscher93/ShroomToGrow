[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_ichor_def.tres" id="3_cur_ichor"]
[ext_resource type="Resource" path="res://data/currencies/res_glyphs_def.tres" id="4_cur_glyphs"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="5_effect_script"]

[sub_resource type="Resource" id="payout_ichor"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_ichor")
gain_stat = &"ichor_gain"
_amount_mantissa = 3.329752
_amount_exponent = 4

[sub_resource type="Resource" id="payout_glyphs"]
script = ExtResource("2_payout_script")
currency = ExtResource("4_cur_glyphs")
gain_stat = &"glyph_gain"
_amount_mantissa = 2.219835
_amount_exponent = 4

[sub_resource type="Resource" id="reward_0"]
script = ExtResource("5_effect_script")
stat = &"mission_speed"
op = 2
scope = 2
target = &"farm_dredge_the_fen"
per_level = 0.3
level_scaling = 0

[resource]
script = ExtResource("1_script")
id = &"mire_wyrm_coil_through_the_weeping_deep"
display_name = "Coil Through the Weeping Deep"
description = "Coil Through the Weeping Deep. Step 15 of Mire Wyrm's chain."
is_farm = false
hero_id = &"mire_wyrm"
base_duration_seconds = 6239.5
min_hero_level = 1
min_missions_completed = 0
unlock_perk_id = &""
requires_mission_id = &""
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_ichor"), SubResource("payout_glyphs")])
rewards = Array[ExtResource("5_effect_script")]([SubResource("reward_0")])
