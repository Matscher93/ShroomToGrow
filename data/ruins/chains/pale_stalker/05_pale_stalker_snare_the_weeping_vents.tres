stat = &"mission_reward"
op = 2
scope = 2
target = &"farm_tap_the_seeps"
per_level = 0.2
level_scaling = 0

[resource]
script = ExtResource("1_script")
id = &"pale_stalker_snare_the_weeping_vents"
display_name = "Snare the Weeping Vents"
description = "Snare the Weeping Vents. Step 5 of Pale Stalker's chain."
is_farm = false
hero_id = &"pale_stalker"
