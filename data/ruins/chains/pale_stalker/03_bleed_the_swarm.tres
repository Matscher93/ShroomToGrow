[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_ichor_def.tres" id="3_cur_ichor"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="4_effect_script"]

[sub_resource type="Resource" id="payout_ichor"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_ichor")
gain_stat = &"ichor_gain"
_amount_mantissa = 2.0
_amount_exponent = 1

[sub_resource type="Resource" id="reward_0"]
script = ExtResource("4_effect_script")
stat = &"automation_rate"
op = 2
scope = 0
target = &""
per_level = 0.25
level_scaling = 0

[resource]
script = ExtResource("1_script")
id = &"bleed_the_swarm"
display_name = "Bleed the Swarm"
description = "Bleed the Swarm. Step 3 of Pale Stalker's chain."
is_farm = false
hero_id = &"pale_stalker"
base_duration_seconds = 300.0
min_hero_level = 1
min_missions_completed = 0
unlock_perk_id = &""
requires_mission_id = &""
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_ichor")])
rewards = Array[ExtResource("4_effect_script")]([SubResource("reward_0")])
