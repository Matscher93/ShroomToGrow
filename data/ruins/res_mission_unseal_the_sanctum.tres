[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_glyphs_def.tres" id="3_cur_glyphs"]
[ext_resource type="Resource" path="res://data/currencies/res_relics_def.tres" id="4_cur_relics"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="5_effect_script"]

[sub_resource type="Resource" id="payout_glyphs"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_glyphs")
gain_stat = &"glyph_gain"
_amount_mantissa = 3.8
_amount_exponent = 2

[sub_resource type="Resource" id="payout_relics"]
script = ExtResource("2_payout_script")
currency = ExtResource("4_cur_relics")
gain_stat = &"relic_gain"
_amount_mantissa = 6.0
_amount_exponent = 2

[sub_resource type="Resource" id="reward_0"]
script = ExtResource("5_effect_script")
stat = &"biomass_gain"
op = 2
scope = 0
target = &""
per_level = 1.0
level_scaling = 0

[resource]
script = ExtResource("1_script")
id = &"unseal_the_sanctum"
display_name = "Unseal the Sanctum"
description = "The last door, and the only one that was locked from the inside."
is_farm = false
base_duration_seconds = 3600.0
min_creature_rank = 4
min_missions_completed = 60
unlock_perk_id = &""
requires_mission_id = &""
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_glyphs"), SubResource("payout_relics")])
rewards = Array[ExtResource("5_effect_script")]([SubResource("reward_0")])
