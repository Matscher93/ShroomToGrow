[gd_resource type="Resource" script_class="MissionDef" format=3]

[ext_resource type="Script" path="res://model/ruins/res_mission_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/ruins/res_mission_payout_def.gd" id="2_payout_script"]
[ext_resource type="Resource" path="res://data/currencies/res_relics_def.tres" id="3_cur_relics"]

[sub_resource type="Resource" id="payout_relics"]
script = ExtResource("2_payout_script")
currency = ExtResource("3_cur_relics")
gain_stat = &"relic_gain"
_amount_mantissa = 5.0
_amount_exponent = 0

[resource]
script = ExtResource("1_script")
id = &"sift_rubble"
display_name = "Sift the Rubble"
description = "Send a thrall over the collapsed entry hall, turning stones until something worked by hands comes up."
base_duration_seconds = 45.0
min_creature_rank = 1
min_missions_completed = 0
unlock_perk_id = &""
payouts = Array[ExtResource("2_payout_script")]([SubResource("payout_relics")])
