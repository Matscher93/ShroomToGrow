[resource]
script = ExtResource("1_script")
id = &"project_forest"
display_name = "Drowned Forest"
description = "x1.045 biomass gained on sporation, per level, compounding."
max_level = 60
min_project_levels = 359
_base_cost_mantissa = 5.0
_base_cost_exponent = 7
cost_growth = 1.46
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_roots2"), SubResource("boon_standing"), SubResource("boon_canopy"), SubResource("boon_rot")])
