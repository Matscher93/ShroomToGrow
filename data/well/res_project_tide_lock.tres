[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_chamber"]
script = ExtResource("3_effect_script")
stat = &"water_rate"
op = 0
scope = 0
target = &""
per_level = -0.14
level_scaling = 0
max_magnitude = 3.0

[sub_resource type="Resource" id="boon_chamber"]
script = ExtResource("2_boon_script")
display_name = "Lock Chamber"
description = "-0.14 ticks between pumps, per level, up to -3.00."
unlock_at_level = 1
effect = SubResource("effect_chamber")

[sub_resource type="Resource" id="effect_cadence"]
script = ExtResource("3_effect_script")
stat = &"tick_rate"
op = 0
scope = 0
target = &""
per_level = -0.035
level_scaling = 0
max_magnitude = 0.8

[sub_resource type="Resource" id="boon_cadence"]
script = ExtResource("2_boon_script")
display_name = "Cadence"
description = "-0.04s tick duration, per level, up to -0.80s."
unlock_at_level = 5
effect = SubResource("effect_cadence")

[sub_resource type="Resource" id="effect_cycle"]
script = ExtResource("3_effect_script")
stat = &"boost_max_level"
op = 0
scope = 2
target = &"boost_biomass"
per_level = 3.0
level_scaling = 0

[sub_resource type="Resource" id="boon_cycle"]
script = ExtResource("2_boon_script")
display_name = "Lock Cycling"
description = "+3 max levels for Spore Density, per level."
unlock_at_level = 15
effect = SubResource("effect_cycle")

[sub_resource type="Resource" id="effect_spill"]
script = ExtResource("3_effect_script")
stat = &"water_rate"
op = 0
scope = 0
target = &""
per_level = -0.22
level_scaling = 0
max_magnitude = 4.5

[sub_resource type="Resource" id="boon_spill"]
script = ExtResource("2_boon_script")
display_name = "Spillway"
description = "-0.22 ticks between pumps, per level, up to -4.50."
unlock_at_level = 40
effect = SubResource("effect_spill")

[resource]
script = ExtResource("1_script")
id = &"project_lock"
display_name = "Tide Lock"
description = "Two levels, one gate, and the difference between them doing all the work."
max_level = 60
min_project_levels = 625
_base_cost_mantissa = 5.0
_base_cost_exponent = 9
cost_growth = 1.49
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_chamber"), SubResource("boon_cadence"), SubResource("boon_cycle"), SubResource("boon_spill")])
