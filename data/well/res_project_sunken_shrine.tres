[resource]
script = ExtResource("1_script")
id = &"project_shrine"
display_name = "Sunken Shrine"
description = "Something older than the colony is down there. What it gives back outlasts every sporation."
max_level = 60
min_project_levels = 55
_base_cost_mantissa = 1.0
_base_cost_exponent = 2
cost_growth = 1.45
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_offering"), SubResource("boon_votive"), SubResource("boon_drowned"), SubResource("boon_rite")])
