[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_vault"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.05
level_scaling = 1

[sub_resource type="Resource" id="boon_vault"]
script = ExtResource("2_boon_script")
display_name = "Vault Store"
description = "{value} water per pump, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_vault")

[sub_resource type="Resource" id="effect_pillar"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 2
target = &"6"
per_level = 0.055
level_scaling = 1

[sub_resource type="Resource" id="boon_pillar"]
script = ExtResource("2_boon_script")
display_name = "Pillar Beds"
description = "{value} node production on {scope}, per level, compounding."
unlock_at_level = 5
effect = SubResource("effect_pillar")

[sub_resource type="Resource" id="effect_flowstone"]
script = ExtResource("3_effect_script")
stat = &"biomass_gain"
op = 2
scope = 0
target = &""
per_level = 0.045
level_scaling = 1

[sub_resource type="Resource" id="boon_flowstone"]
script = ExtResource("2_boon_script")
display_name = "Flowstone"
description = "{value} biomass gained on sporation, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_flowstone")

[sub_resource type="Resource" id="effect_cavern"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.03
level_scaling = 1

[sub_resource type="Resource" id="boon_cavern"]
script = ExtResource("2_boon_script")
display_name = "Cavern Volume"
description = "{value} water per pump, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_cavern")

[resource]
script = ExtResource("1_script")
id = &"project_karst"
display_name = "Karst Vault"
description = "The whole hillside is hollow. It has been holding this the entire time."
max_level = 60
min_project_levels = 530
_base_cost_mantissa = 1.0
_base_cost_exponent = 9
cost_growth = 1.48
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_vault"), SubResource("boon_pillar"), SubResource("boon_flowstone"), SubResource("boon_cavern")])
