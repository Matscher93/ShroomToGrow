[resource]
script = ExtResource("1_script")
id = &"project_mirror"
display_name = "Mirror Pool"
description = "Perfectly still, and it shows you a colony that is doing rather better."
max_level = 60
min_project_levels = 399
_base_cost_mantissa = 1.0
_base_cost_exponent = 8
cost_growth = 1.47
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_still"), SubResource("boon_reflect"), SubResource("boon_double"), SubResource("boon_image")])
