[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_drain"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.06
level_scaling = 1

[sub_resource type="Resource" id="boon_drain"]
script = ExtResource("2_boon_script")
display_name = "Drain"
description = "x1.06 water per pump, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_drain")

[sub_resource type="Resource" id="effect_gather"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 0
target = &""
per_level = 0.04
level_scaling = 1

[sub_resource type="Resource" id="boon_gather"]
script = ExtResource("2_boon_script")
display_name = "Gathering"
description = "x1.04 production on every node, per level, compounding."
unlock_at_level = 5
effect = SubResource("effect_gather")

[sub_resource type="Resource" id="effect_settle"]
script = ExtResource("3_effect_script")
stat = &"crystal_gain"
op = 2
scope = 0
target = &""
per_level = 0.06
level_scaling = 1

[sub_resource type="Resource" id="boon_settle"]
script = ExtResource("2_boon_script")
display_name = "Settling"
description = "x1.06 crystals from achievements, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_settle")

[sub_resource type="Resource" id="effect_sink2"]
script = ExtResource("3_effect_script")
stat = &"biomass_gain"
op = 2
scope = 0
target = &""
per_level = 0.04
level_scaling = 1

[sub_resource type="Resource" id="boon_sink2"]
script = ExtResource("2_boon_script")
display_name = "The Sink"
description = "x1.04 biomass gained on sporation, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_sink2")

[resource]
script = ExtResource("1_script")
id = &"project_sink"
display_name = "World Sink"
description = "Everything above drains to here. Everything."
max_level = 60
min_project_levels = 1009
_base_cost_mantissa = 1.0
_base_cost_exponent = 13
cost_growth = 1.53
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_drain"), SubResource("boon_gather"), SubResource("boon_settle"), SubResource("boon_sink2")])
