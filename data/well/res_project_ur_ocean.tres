[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_memory"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.05
level_scaling = 1

[sub_resource type="Resource" id="boon_memory"]
script = ExtResource("2_boon_script")
display_name = "Memory"
description = "{value} water per pump, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_memory")

[sub_resource type="Resource" id="effect_first"]
script = ExtResource("3_effect_script")
stat = &"water_rate"
op = 0
scope = 0
target = &""
per_level = -0.35
level_scaling = 0
max_magnitude = 8.0

[sub_resource type="Resource" id="boon_first"]
script = ExtResource("2_boon_script")
display_name = "First Tide"
description = "{value} ticks between pumps, per level, up to {cap}."
unlock_at_level = 5
effect = SubResource("effect_first")

[sub_resource type="Resource" id="effect_origin"]
script = ExtResource("3_effect_script")
stat = &"synergy_production"
op = 2
scope = 0
target = &""
per_level = 0.035
level_scaling = 1

[sub_resource type="Resource" id="boon_origin"]
script = ExtResource("2_boon_script")
display_name = "Origin"
description = "{value} Synergy production, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_origin")

[sub_resource type="Resource" id="effect_ur"]
script = ExtResource("3_effect_script")
stat = &"biomass_gain"
op = 2
scope = 0
target = &""
per_level = 0.05
level_scaling = 1

[sub_resource type="Resource" id="boon_ur"]
script = ExtResource("2_boon_script")
display_name = "The Ur"
description = "{value} biomass gained on sporation, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_ur")

[resource]
script = ExtResource("1_script")
id = &"project_urocean"
display_name = "Ur-Ocean"
description = "The water the first spore ever met. It remembers."
max_level = 60
min_project_levels = 1070
_base_cost_mantissa = 1.0
_base_cost_exponent = 15
cost_growth = 1.55
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_memory"), SubResource("boon_first"), SubResource("boon_origin"), SubResource("boon_ur")])
