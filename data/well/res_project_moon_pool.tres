[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_pull"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.055
level_scaling = 1

[sub_resource type="Resource" id="boon_pull"]
script = ExtResource("2_boon_script")
display_name = "Lunar Pull"
description = "{value} water per pump, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_pull")

[sub_resource type="Resource" id="effect_swell"]
script = ExtResource("3_effect_script")
stat = &"water_rate"
op = 0
scope = 0
target = &""
per_level = -0.25
level_scaling = 0
max_magnitude = 5.0

[sub_resource type="Resource" id="boon_swell"]
script = ExtResource("2_boon_script")
display_name = "Swell"
description = "{value} ticks between pumps, per level, up to {cap}."
unlock_at_level = 5
effect = SubResource("effect_swell")

[sub_resource type="Resource" id="effect_phase"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.035
level_scaling = 1

[sub_resource type="Resource" id="boon_phase"]
script = ExtResource("2_boon_script")
display_name = "Phase"
description = "{value} water per pump, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_phase")

[sub_resource type="Resource" id="effect_silver"]
script = ExtResource("3_effect_script")
stat = &"biomass_gain"
op = 2
scope = 0
target = &""
per_level = 0.055
level_scaling = 1

[sub_resource type="Resource" id="boon_silver"]
script = ExtResource("2_boon_script")
display_name = "Silver Water"
description = "{value} biomass gained on sporation, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_silver")

[resource]
script = ExtResource("1_script")
id = &"project_moon"
display_name = "Moon Pool"
description = "{value:3} biomass gained on sporation, per level, compounding."
max_level = 60
min_project_levels = 780
_base_cost_mantissa = 5.0
_base_cost_exponent = 10
cost_growth = 1.51
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_pull"), SubResource("boon_swell"), SubResource("boon_phase"), SubResource("boon_silver")])
