[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_seep2"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.035
level_scaling = 1

[sub_resource type="Resource" id="boon_seep2"]
script = ExtResource("2_boon_script")
display_name = "Hairline Seep"
description = "x1.035 water per pump, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_seep2")

[sub_resource type="Resource" id="effect_damp"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 0
target = &""
per_level = 0.025
level_scaling = 1

[sub_resource type="Resource" id="boon_damp"]
script = ExtResource("2_boon_script")
display_name = "Damp Substrate"
description = "x1.025 production on every node, per level, compounding."
unlock_at_level = 5
effect = SubResource("effect_damp")

[sub_resource type="Resource" id="effect_runnels"]
script = ExtResource("3_effect_script")
stat = &"water_rate"
op = 0
scope = 0
target = &""
per_level = -0.06
level_scaling = 0
max_magnitude = 1.5

[sub_resource type="Resource" id="boon_runnels"]
script = ExtResource("2_boon_script")
display_name = "Runnels"
description = "-0.06 ticks between pumps, per level, up to -1.50."
unlock_at_level = 15
effect = SubResource("effect_runnels")

[sub_resource type="Resource" id="effect_sheet"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.05
level_scaling = 1

[sub_resource type="Resource" id="boon_sheet"]
script = ExtResource("2_boon_script")
display_name = "Sheeting"
description = "x1.05 water per pump, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_sheet")

[resource]
script = ExtResource("1_script")
id = &"project_weeping"
display_name = "Weeping Wall"
description = "x1.05 water per pump, per level, compounding."
max_level = 60
min_project_levels = 181
_base_cost_mantissa = 1.0
_base_cost_exponent = 6
cost_growth = 1.44
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_seep2"), SubResource("boon_damp"), SubResource("boon_runnels"), SubResource("boon_sheet")])
