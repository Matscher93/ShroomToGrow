[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_first"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 2
target = &"1"
per_level = 0.045
level_scaling = 1

[sub_resource type="Resource" id="boon_first"]
script = ExtResource("2_boon_script")
display_name = "First Terrace"
description = "{value} node production on {scope}, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_first")

[sub_resource type="Resource" id="effect_second"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 2
target = &"2"
per_level = 0.045
level_scaling = 1

[sub_resource type="Resource" id="boon_second"]
script = ExtResource("2_boon_script")
display_name = "Second Terrace"
description = "{value} node production on {scope}, per level, compounding."
unlock_at_level = 5
effect = SubResource("effect_second")

[sub_resource type="Resource" id="effect_third"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 2
target = &"4"
per_level = 0.055
level_scaling = 1

[sub_resource type="Resource" id="boon_third"]
script = ExtResource("2_boon_script")
display_name = "Third Terrace"
description = "{value} node production on {scope}, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_third")

[sub_resource type="Resource" id="effect_bloom"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 0
target = &""
per_level = 0.025
level_scaling = 1

[sub_resource type="Resource" id="boon_bloom"]
script = ExtResource("2_boon_script")
display_name = "Silt Bloom"
description = "{value} production on every node, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_bloom")

[resource]
script = ExtResource("1_script")
id = &"project_terraces"
display_name = "Silt Terraces"
description = "{value:3} production on every node, per level, compounding."
max_level = 60
min_project_levels = 95
_base_cost_mantissa = 5.0
_base_cost_exponent = 3
cost_growth = 1.5
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_first"), SubResource("boon_second"), SubResource("boon_third"), SubResource("boon_bloom")])
