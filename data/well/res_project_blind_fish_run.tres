[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_shoal"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 2
target = &"1"
per_level = 0.045
level_scaling = 1

[sub_resource type="Resource" id="boon_shoal"]
script = ExtResource("2_boon_script")
display_name = "Shoal Beds"
description = "{value} node production on {scope}, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_shoal")

[sub_resource type="Resource" id="effect_deeper"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 2
target = &"3"
per_level = 0.05
level_scaling = 1

[sub_resource type="Resource" id="boon_deeper"]
script = ExtResource("2_boon_script")
display_name = "Deeper Shoals"
description = "{value} node production on {scope}, per level, compounding."
unlock_at_level = 5
effect = SubResource("effect_deeper")

[sub_resource type="Resource" id="effect_instinct"]
script = ExtResource("3_effect_script")
stat = &"boost_power"
op = 2
scope = 2
target = &"boost_nutrients"
per_level = 0.02
level_scaling = 1

[sub_resource type="Resource" id="boon_instinct"]
script = ExtResource("2_boon_script")
display_name = "Blind Instinct"
description = "{value} Nutrient Flow strength, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_instinct")

[sub_resource type="Resource" id="effect_swarm"]
script = ExtResource("3_effect_script")
stat = &"node_production"
op = 2
scope = 0
target = &""
per_level = 0.025
level_scaling = 1

[sub_resource type="Resource" id="boon_swarm"]
script = ExtResource("2_boon_script")
display_name = "Swarm Feeding"
description = "{value} production on every node, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_swarm")

[resource]
script = ExtResource("1_script")
id = &"project_fish"
display_name = "Blind Fish Run"
description = "{value:3} production on every node, per level, compounding."
max_level = 60
min_project_levels = 247
_base_cost_mantissa = 5.0
_base_cost_exponent = 6
cost_growth = 1.45
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_shoal"), SubResource("boon_deeper"), SubResource("boon_instinct"), SubResource("boon_swarm")])
