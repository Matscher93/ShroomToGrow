[gd_resource type="Resource" script_class="ProjectDef" format=3]

[ext_resource type="Script" path="res://model/well/res_project_def.gd" id="1_script"]
[ext_resource type="Script" path="res://model/well/res_project_boon_def.gd" id="2_boon_script"]
[ext_resource type="Script" path="res://model/upgrades/res_upgrade_effect_def.gd" id="3_effect_script"]

[sub_resource type="Resource" id="effect_reservoir_deep"]
script = ExtResource("3_effect_script")
stat = &"water_production"
op = 2
scope = 0
target = &""
per_level = 0.03
level_scaling = 1

[sub_resource type="Resource" id="boon_reservoir_deep"]
script = ExtResource("2_boon_script")
display_name = "Deep Reservoir"
description = "{value} water per pump, per level, compounding."
unlock_at_level = 1
effect = SubResource("effect_reservoir_deep")

[sub_resource type="Resource" id="effect_seal"]
script = ExtResource("3_effect_script")
stat = &"water_rate"
op = 0
scope = 0
target = &""
per_level = -0.2
level_scaling = 0
max_magnitude = 4.0

[sub_resource type="Resource" id="boon_seal"]
script = ExtResource("2_boon_script")
display_name = "Pressure Seal"
description = "{value} ticks between pumps, per level, up to {cap}."
unlock_at_level = 5
effect = SubResource("effect_seal")

[sub_resource type="Resource" id="effect_current"]
script = ExtResource("3_effect_script")
stat = &"crystal_gain"
op = 2
scope = 0
target = &""
per_level = 0.045
level_scaling = 1

[sub_resource type="Resource" id="boon_current"]
script = ExtResource("2_boon_script")
display_name = "Cold Current"
description = "{value} crystals from achievements, per level, compounding."
unlock_at_level = 15
effect = SubResource("effect_current")

[sub_resource type="Resource" id="effect_deep"]
script = ExtResource("3_effect_script")
stat = &"biomass_gain"
op = 2
scope = 0
target = &""
per_level = 0.04
level_scaling = 1

[sub_resource type="Resource" id="boon_deep"]
script = ExtResource("2_boon_script")
display_name = "The Deep"
description = "{value} biomass gained on sporation, per level, compounding."
unlock_at_level = 40
effect = SubResource("effect_deep")

[resource]
script = ExtResource("1_script")
id = &"project_abyss"
display_name = "Abyssal Cistern"
description = "Below the lake is more lake. Whatever is drawn from this depth keeps paying after the colony is gone."
max_level = 60
min_project_levels = 150
_base_cost_mantissa = 1.0
_base_cost_exponent = 5
cost_growth = 1.55
cost_growth_exponent = 1.0
boons = Array[ExtResource("2_boon_script")]([SubResource("boon_reservoir_deep"), SubResource("boon_seal"), SubResource("boon_current"), SubResource("boon_deep")])
