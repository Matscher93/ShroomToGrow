[resource]
script = ExtResource("1_script")
id = &"project_leviathan"
display_name = "Leviathan Bore"
description = "The tunnel is round, and smooth, and something made it that way."
max_level = 60
min_project_levels = 949
_base_cost_mantissa = 5.0
_base_cost_exponent = 11
cost_growth = 1.52
cost_growth_exponent = 1.0
