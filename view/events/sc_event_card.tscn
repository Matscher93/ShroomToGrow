[sub_resource type="LabelSettings" id="LabelSettings_progress"]
font = ExtResource("2_num_font")
font_size = 10
font_color = Color(0.56078434, 0.7019608, 0.6509804, 1)

[node name="event_card" type="PanelContainer" node_paths=PackedStringArray("color_rail", "color_dot", "lbl_eyebrow", "btn_skip", "lbl_title", "lbl_description", "btn_collect", "box_spend", "lbl_spend", "lbl_spend_reward", "btn_fulfil", "box_progress", "lbl_progress", "lbl_progress_reward", "bar_progress")]
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("1_script")
color_rail = NodePath("HBoxContainer/color_rail")
color_dot = NodePath("HBoxContainer/VBoxContainer/header/dot_wrap/color_dot")
lbl_eyebrow = NodePath("HBoxContainer/VBoxContainer/header/lbl_eyebrow")
btn_skip = NodePath("HBoxContainer/VBoxContainer/header/btn_skip")
lbl_title = NodePath("HBoxContainer/VBoxContainer/lbl_title")
