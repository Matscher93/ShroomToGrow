box_progress = NodePath("HBoxContainer/VBoxContainer/box_progress")
lbl_progress = NodePath("HBoxContainer/VBoxContainer/box_progress/HBoxContainer/lbl_progress")
lbl_progress_reward = NodePath("HBoxContainer/VBoxContainer/box_progress/HBoxContainer/lbl_progress_reward")
bar_progress = NodePath("HBoxContainer/VBoxContainer/box_progress/bar_progress")

[node name="HBoxContainer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 11

