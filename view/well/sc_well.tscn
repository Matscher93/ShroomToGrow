[gd_scene format=3]

[ext_resource type="Script" path="res://view/well/gd_well_panel.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://view/well/sc_project_card.tscn" id="2_project_card"]
[ext_resource type="Script" path="res://view/base_views/gd_touch_scroll_container.gd" id="3_touch_scroll"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_well"]

[node name="well" type="PanelContainer" node_paths=PackedStringArray("lbl_pump", "vbox_projects", "scroll")]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/panel = SubResource("StyleBoxEmpty_well")
script = ExtResource("1_script")
lbl_pump = NodePath("ScrollContainer/MarginContainer/VBoxContainer/lbl_pump")
vbox_projects = NodePath("ScrollContainer/MarginContainer/VBoxContainer/vbox_projects")
scroll = NodePath("ScrollContainer")
project_card_scene = ExtResource("2_project_card")

[node name="ScrollContainer" type="ScrollContainer" parent="."]
script = ExtResource("3_touch_scroll")
layout_mode = 2
vertical_scroll_mode = 2

[node name="MarginContainer" type="MarginContainer" parent="ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 118

[node name="VBoxContainer" type="VBoxContainer" parent="ScrollContainer/MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="lbl_pump" type="Label" parent="ScrollContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Pumps 1 water every 10 ticks."
autowrap_mode = 3

[node name="lbl_hint" type="Label" parent="ScrollContainer/MarginContainer/VBoxContainer"]
modulate = Color(1, 1, 1, 0.5)
layout_mode = 2
text = "Projects are funded with water. A sporation drains the water but never the project - fund a rung far enough and it opens the next one."
autowrap_mode = 3

[node name="vbox_projects" type="VBoxContainer" parent="ScrollContainer/MarginContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
