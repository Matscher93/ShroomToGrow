[gd_scene format=3]

[ext_resource type="Script" path="res://view/well/gd_project_card.gd" id="1_script"]
[ext_resource type="Script" uid="uid://dhdlai82e2tmo" path="res://view/base_views/gd_base_button.gd" id="2_hold_repeat"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_project_card"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.09019608, 0.13333334, 0.15294118, 0.55)
border_width_left = 2
border_color = Color(0.37254903, 0.7764706, 0.9137255, 0.5)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="project_card" type="PanelContainer" node_paths=PackedStringArray("lbl_name", "lbl_description", "lbl_boons", "lbl_level", "lbl_cost", "btn_invest", "vbox_boons")]
theme_override_styles/panel = SubResource("StyleBoxFlat_project_card")
script = ExtResource("1_script")
lbl_name = NodePath("VBoxContainer/header/lbl_name")
lbl_description = NodePath("VBoxContainer/lbl_description")
lbl_boons = NodePath("VBoxContainer/header/lbl_boons")
lbl_level = NodePath("VBoxContainer/footer/lbl_level")
lbl_cost = NodePath("VBoxContainer/footer/lbl_cost")
btn_invest = NodePath("VBoxContainer/footer/btn_invest")
vbox_boons = NodePath("VBoxContainer/vbox_boons")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="lbl_name" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Project"

[node name="lbl_boons" type="Label" parent="VBoxContainer/header"]
modulate = Color(0.7607843, 0.94509804, 0.98039216, 1)
layout_mode = 2
text = "1 / 4 boons"

[node name="lbl_description" type="Label" parent="VBoxContainer"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
text = "What this project digs towards."
autowrap_mode = 3

[node name="vbox_boons" type="VBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="footer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="lbl_level" type="Label" parent="VBoxContainer/footer"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
size_flags_horizontal = 3
text = "Lv 0 / 50"

[node name="lbl_cost" type="Label" parent="VBoxContainer/footer"]
modulate = Color(0.7607843, 0.94509804, 0.98039216, 1)
layout_mode = 2
text = "0 water"

[node name="btn_invest" type="Button" parent="VBoxContainer/footer"]
layout_mode = 2
text = "Fund"
script = ExtResource("2_hold_repeat")
