[gd_scene format=3]

[ext_resource type="Script" path="res://view/crystal_caves/gd_automation_card.gd" id="1_script"]
[ext_resource type="Script" uid="uid://dhdlai82e2tmo" path="res://view/base_views/gd_base_button.gd" id="2_hold_repeat"]
[ext_resource type="FontFile" uid="uid://cgxf7l60an3ht" path="res://fonts/JetBrains_Mono/JetBrainsMono-Bold.ttf" id="3_num_font"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_automation_card"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.09019608, 0.13333334, 0.15294118, 0.55)
border_width_left = 2
border_color = Color(0.36078432, 0.78431374, 0.9019608, 0.5)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="automation_card" type="PanelContainer" node_paths=PackedStringArray("lbl_name", "lbl_description", "lbl_lock", "lbl_level", "lbl_rate", "lbl_next_rate", "lbl_cost", "btn_buy", "btn_enabled")]
theme_override_styles/panel = SubResource("StyleBoxFlat_automation_card")
script = ExtResource("1_script")
lbl_name = NodePath("VBoxContainer/header/lbl_name")
lbl_description = NodePath("VBoxContainer/lbl_description")
lbl_lock = NodePath("VBoxContainer/lbl_lock")
lbl_level = NodePath("VBoxContainer/header/lbl_level")
lbl_rate = NodePath("VBoxContainer/footer/lbl_rate")
lbl_next_rate = NodePath("VBoxContainer/footer/lbl_next_rate")
lbl_cost = NodePath("VBoxContainer/footer/lbl_cost")
btn_buy = NodePath("VBoxContainer/footer/btn_buy")
btn_enabled = NodePath("VBoxContainer/header/btn_enabled")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="lbl_name" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Automation"

[node name="lbl_level" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
text = "Lv 0"

[node name="btn_enabled" type="CheckButton" parent="VBoxContainer/header"]
layout_mode = 2
text = "Enabled"

[node name="lbl_description" type="Label" parent="VBoxContainer"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
text = "What this one buys for you."
autowrap_mode = 3

[node name="lbl_lock" type="Label" parent="VBoxContainer"]
modulate = Color(1, 1, 1, 0.5)
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="footer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="lbl_rate" type="Label" parent="VBoxContainer/footer"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
text = ""

[node name="lbl_next_rate" type="Label" parent="VBoxContainer/footer"]
modulate = Color(1, 1, 1, 0.45)
layout_mode = 2
size_flags_horizontal = 3
text = ""

[node name="lbl_cost" type="Label" parent="VBoxContainer/footer"]
modulate = Color(0.7607843, 0.94509804, 0.98039216, 1)
layout_mode = 2
theme_override_fonts/font = ExtResource("3_num_font")
text = "0"

[node name="btn_buy" type="Button" parent="VBoxContainer/footer"]
layout_mode = 2
text = "Buy"
script = ExtResource("2_hold_repeat")
