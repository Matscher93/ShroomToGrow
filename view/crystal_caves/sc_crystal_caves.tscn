[node name="lbl_auto_unlocks_hint" type="Label" parent="VBoxContainer/TabContainer/Automations/MarginContainer/VBoxContainer/auto_unlock_section"]
modulate = Color(1, 1, 1, 0.5)
layout_mode = 2
