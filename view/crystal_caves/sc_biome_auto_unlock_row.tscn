[node name="HBoxContainer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="lbl_name" type="Label" parent="HBoxContainer"]
layout_mode = 2
text = "Biome"

[node name="lbl_status" type="Label" parent="HBoxContainer"]
