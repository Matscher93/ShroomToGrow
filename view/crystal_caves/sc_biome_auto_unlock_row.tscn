[node name="btn_enabled" type="Button" parent="HBoxContainer"]
visible = false
custom_minimum_size = Vector2(56, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Switch off to make this biome relock after a sporation. The purchase is kept."
text = "On"
