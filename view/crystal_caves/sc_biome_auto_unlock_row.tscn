[gd_scene format=3]

[ext_resource type="Script" path="res://view/crystal_caves/gd_biome_auto_unlock_row.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_auto_unlock_row"]
content_margin_left = 12.0
