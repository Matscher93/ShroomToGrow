[node name="achievement_row" type="PanelContainer" node_paths=PackedStringArray("lbl_name", "lbl_description", "lbl_tier", "lbl_progress", "lbl_reward", "bar_progress", "btn_claim")]
theme_override_styles/panel = SubResource("StyleBoxFlat_achievement_row")
script = ExtResource("1_script")
lbl_name = NodePath("VBoxContainer/header/lbl_name")
lbl_description = NodePath("VBoxContainer/lbl_description")
lbl_tier = NodePath("VBoxContainer/header/lbl_tier")
lbl_progress = NodePath("VBoxContainer/footer/lbl_progress")
lbl_reward = NodePath("VBoxContainer/footer/lbl_reward")
bar_progress = NodePath("VBoxContainer/bar_progress")
btn_claim = NodePath("VBoxContainer/footer/btn_claim")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="lbl_name" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Achievement"

[node name="lbl_tier" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
text = "Tier 1"

[node name="lbl_description" type="Label" parent="VBoxContainer"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
text = "What this one asks for."
autowrap_mode = 3

[node name="bar_progress" type="ProgressBar" parent="VBoxContainer"]
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
theme_override_styles/background = SubResource("StyleBoxFlat_bar_bg")
theme_override_styles/fill = SubResource("StyleBoxFlat_bar_fill")
value = 0.0
show_percentage = false

[node name="footer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="lbl_progress" type="Label" parent="VBoxContainer/footer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_fonts/font = ExtResource("3_num_font")
