[node name="lbl_reward" type="Label" parent="VBoxContainer/footer"]
modulate = Color(0.7607843, 0.94509804, 0.98039216, 1)
layout_mode = 2
theme_override_fonts/font = ExtResource("3_num_font")
text = "+0"

[node name="btn_claim" type="Button" parent="VBoxContainer/footer"]
layout_mode = 2
