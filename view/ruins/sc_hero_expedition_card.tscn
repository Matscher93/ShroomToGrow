[node name="lbl_countdown" type="Label" parent="VBoxContainer/chain_row"]
modulate = Color(0.9647059, 0.8666667, 0.68235296, 1)
layout_mode = 2
theme_override_fonts/font = ExtResource("2_num_font")
text = ""

[node name="bar_progress" type="ProgressBar" parent="VBoxContainer"]
visible = false
