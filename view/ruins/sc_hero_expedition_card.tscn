script = ExtResource("1_script")
lbl_name = NodePath("VBoxContainer/header/lbl_name")
lbl_level = NodePath("VBoxContainer/header/lbl_level")
lbl_chain = NodePath("VBoxContainer/chain_row/lbl_chain")
lbl_step = NodePath("VBoxContainer/chain_row/lbl_step")
lbl_countdown = NodePath("VBoxContainer/chain_row/lbl_countdown")
lbl_reward = NodePath("VBoxContainer/lbl_reward")
lbl_boon = NodePath("VBoxContainer/lbl_boon")
lbl_status = NodePath("VBoxContainer/lbl_status")
bar_progress = NodePath("VBoxContainer/bar_progress")
btn_action = NodePath("VBoxContainer/footer/btn_action")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="lbl_name" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
size_flags_horizontal = 3
