corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="hero_expedition_card" type="PanelContainer" node_paths=PackedStringArray("lbl_name", "lbl_level", "lbl_chain", "lbl_step", "lbl_countdown", "lbl_reward", "lbl_boon", "lbl_status", "bar_progress", "btn_action")]
