[node name="sheet" type="PanelContainer" parent="."]
layout_mode = 2
size_flags_vertical = 0
theme_override_styles/panel = SubResource("StyleBoxFlat_sheet")

[node name="VBoxContainer" type="VBoxContainer" parent="sheet"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="header" type="HBoxContainer" parent="sheet/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="lbl_title" type="Label" parent="sheet/VBoxContainer/header"]
