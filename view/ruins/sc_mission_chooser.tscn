[ext_resource type="Script" path="res://view/base_views/gd_touch_scroll_container.gd" id="4_touch_scroll"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_backdrop"]
bg_color = Color(0.03137255, 0.023529412, 0.015686275, 0.62)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_sheet"]
content_margin_left = 14.0
