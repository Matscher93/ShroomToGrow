content_margin_right = 14.0
content_margin_bottom = 14.0
bg_color = Color(0.08627451, 0.06666667, 0.047058824, 1)
border_width_bottom = 1
border_color = Color(1, 1, 1, 0.09)
corner_radius_bottom_right = 24
corner_radius_bottom_left = 24

[sub_resource type="LabelSettings" id="LabelSettings_title"]
font = ExtResource("3_title_font")
font_size = 18
font_color = Color(0.9647059, 0.9411765, 0.9254902, 1)

[node name="mission_chooser" type="PanelContainer" node_paths=PackedStringArray("lbl_title", "lbl_empty", "btn_close", "vbox_missions")]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_backdrop")
script = ExtResource("1_script")
lbl_title = NodePath("sheet/VBoxContainer/header/lbl_title")
lbl_empty = NodePath("sheet/VBoxContainer/ScrollContainer/VBoxContainer/lbl_empty")
btn_close = NodePath("sheet/VBoxContainer/header/btn_close")
vbox_missions = NodePath("sheet/VBoxContainer/ScrollContainer/VBoxContainer/vbox_missions")
