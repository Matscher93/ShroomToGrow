[gd_scene format=3]

[ext_resource type="Script" path="res://view/ruins/gd_mission_choice_row.gd" id="1_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_row"]
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0
bg_color = Color(0.13333334, 0.10980392, 0.09019608, 0.55)
border_width_left = 2
border_color = Color(0.7647059, 0.5137255, 0.30588236, 0.5)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="mission_choice_row" type="PanelContainer" node_paths=PackedStringArray("lbl_name", "lbl_reward", "lbl_boon", "lbl_status", "opt_creature", "btn_start")]
theme_override_styles/panel = SubResource("StyleBoxFlat_row")
script = ExtResource("1_script")
lbl_name = NodePath("VBoxContainer/header/lbl_name")
lbl_reward = NodePath("VBoxContainer/header/lbl_reward")
lbl_boon = NodePath("VBoxContainer/lbl_boon")
lbl_status = NodePath("VBoxContainer/lbl_status")
opt_creature = NodePath("VBoxContainer/footer/opt_creature")
btn_start = NodePath("VBoxContainer/footer/btn_start")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="header" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="lbl_name" type="Label" parent="VBoxContainer/header"]
layout_mode = 2
size_flags_horizontal = 3
text = "Mission"

[node name="lbl_reward" type="Label" parent="VBoxContainer/header"]
modulate = Color(0.9647059, 0.8666667, 0.68235296, 1)
layout_mode = 2
text = "0 relics"

[node name="lbl_boon" type="Label" parent="VBoxContainer"]
modulate = Color(0.68235296, 0.85882354, 0.7019608, 1)
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="lbl_status" type="Label" parent="VBoxContainer"]
modulate = Color(1, 1, 1, 0.65)
layout_mode = 2
text = ""
autowrap_mode = 3

[node name="footer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="opt_creature" type="OptionButton" parent="VBoxContainer/footer"]
layout_mode = 2
size_flags_horizontal = 3
clip_text = true

[node name="btn_start" type="Button" parent="VBoxContainer/footer"]
layout_mode = 2
text = "Send"
